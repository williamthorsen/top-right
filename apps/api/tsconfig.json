{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // Node runs the app by stripping types, which fails on syntax that emits code.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "*.ts"],
}
