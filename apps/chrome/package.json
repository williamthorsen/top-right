{
  "name": "node-monorepo-chrome-template",
  "version": "1.3.1",
  "private": true,
  "description": "Chrome extension template",
  "keywords": [
    "browser-extension",
    "chrome",
    "template",
    "vite"
  ],
  "license": "UNLICENSED",
  "author": "William Thorsen <william@thorsen.dev> (https://github.com/williamthorsen)",
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "build": "pnpm run build:esm && pnpm run build:iife",
    "build:esm": "pnpm vite build",
    "build:iife": "pnpm vite build --config vite.iife.config.ts",
    "dev": "pnpm vite --host",
    "preview": "pnpm vite preview"
  },
  "dependencies": {
    "@williamthorsen/toolbelt.guards": "4.2.0",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/chrome": "0.3.7",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@williamthorsen/nmr": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
