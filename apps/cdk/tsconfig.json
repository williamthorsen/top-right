{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // Node runs the app by stripping types, which fails on syntax that emits code.
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "verbatimModuleSyntax": true,
  },
  // prettier-ignore
  "exclude": [
    ".cdk.out/",
    "node_modules/",
  ],
  // prettier-ignore
  "include": [
    "src/",
    "*.ts",
  ],
}
